{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AI Infra",
  "colors": {
    "primary": "#547483",
    "light": "#AFCBD3",
    "dark": "#425E6B"
  },
  "background": {
    "color": {
      "light": "#FBFCFC",
      "dark": "#1F2B31"
    }
  },
  "appearance": {
    "default": "light"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "首页",
        "icon": "house",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "学习记录",
        "icon": "pen-to-square",
        "groups": [
          {
            "group": "vLLM",
            "pages": [
              "notes/vllm/v1-features",
              "notes/vllm/paged-attention"
            ]
          },
          {
            "group": "CUDA 算子",
            "pages": [
              "notes/cuda/flash-attention",
              "notes/cuda/reduce"
            ]
          }
        ]
      },
      {
        "tab": "方法论",
        "icon": "compass",
        "pages": [
          "notes/method/source-code-learning"
        ]
      },
      {
        "tab": "学习资源",
        "icon": "book-bookmark",
        "pages": [
          "resources"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/file",
      "destination": "/"
    },
    {
      "source": "/untitled-page",
      "destination": "/notes/vllm/v1-features"
    },
    {
      "source": "/file-1-copied-1",
      "destination": "/notes/vllm/paged-attention"
    },
    {
      "source": "/flash-atten-copied-1",
      "destination": "/notes/cuda/flash-attention"
    },
    {
      "source": "/reduce-copied-1",
      "destination": "/notes/cuda/reduce"
    },
    {
      "source": "/development",
      "destination": "/"
    },
    {
      "source": "/essentials/:slug*",
      "destination": "/"
    },
    {
      "source": "/ai-tools/:slug*",
      "destination": "/"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/"
    },
    {
      "source": "/学习资源",
      "destination": "/resources"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/TserJay"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/TserJay"
    }
  }
}
